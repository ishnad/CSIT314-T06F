        <mxCell id="bxH2yGo6510bfVofwbx4-9" value="User Story" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
