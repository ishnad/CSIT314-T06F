        <mxCell id="veOqWCIi8w8CA8tyqoaz-24" value="&lt;b&gt;New Service Listings:&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&quot;VACUUM ONLY&quot; by cleaner1 - Basic Cleaning ($25/hr)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&quot;Basic Cleaning&quot; by cleaner20&quot; - Basic Cleaning ($33/hr)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&quot;Carpet Cleaning&quot; by cleaner19 - Carpet Cleaning ($23/hr)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&quot;Move-In/Move-Out Cleaning&quot; by cleaner19 - Move-In/Move-Out ($32/hr)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&quot;Window Cleaning&quot; by cleaner16 - Window Cleaning ($27/hr)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
