          <mxGeometry x="-78" y="2726.69" width="440.19" height="316.31" as="geometry" />
        </mxCell>
        <mxCell id="z7gGAOTXKP2B1jK29DZv-1" value="" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-39" y="2810.35" width="168" height="149" as="geometry" />
        </mxCell>
        <mxCell id="WT8ZS-W0eel3J1DOiozf-46" value="" style="whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="803.4300000000001" y="2530.85" width="231.03" height="231" as="geometry" />
        </mxCell>
        <mxCell id="aISycYfhNKvwvVBb0uYB-1" value="&lt;span style=&quot;font-family: Ubuntu-Regular, Arial, Helvetica, sans-serif; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(46, 52, 64), rgb(234, 240, 255));&quot;&gt;#16 As a Cleaner, I want to create service listings (e.g. deep cleaning for 3 room HDB) so that I can attract homeowners&lt;/font&gt;&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-72" y="-79" width="399" height="37" as="geometry" />
        </mxCell>
        <mxCell id="aISycYfhNKvwvVBb0uYB-2" value="&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Use Case: Create Service Listings&lt;/span&gt;&lt;div&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Actor: Cleaner&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Description: Cleaner can create and publish new cleaning service listings e.g. Deep Cleaning for 3-Room HDB, Basic Cleaning for Studio Apartment&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Trigger: Cleaner enters&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&quot;My Services&quot; / &quot;Create Listings&quot; page&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Preconditions:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Cleaner must be logged in&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Cleaner must already be in &quot;My Services&quot; / &quot;Create Listings&quot; page&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Normal flow:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;1. Cleaner clicks &quot;Create New Listing&quot;&lt;/div&gt;&lt;div&gt;2. Cleaner enters service details e.g.&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;service listing name,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;service category, description, rate per hour&lt;/span&gt;&lt;/div&gt;&lt;div&gt;3. Cleaner submits and system saves listing&lt;/div&gt;&lt;div&gt;4. System displays new listing with success message &quot;Listing created successfully!&quot;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Alternate flow:&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1a. System error&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- System displays error message &quot;Failed to create service listing due to a server error.&quot;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="-125" y="676.78" width="586" height="363.22" as="geometry" />
        </mxCell>
        <mxCell id="aISycYfhNKvwvVBb0uYB-3" value="&lt;div&gt;Use Case Description&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
