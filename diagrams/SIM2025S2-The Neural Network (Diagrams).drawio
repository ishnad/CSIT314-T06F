        <mxCell id="oDsTDifMXU8W_QaUGRU--16" value="&lt;font face=&quot;Ubuntu-Regular, Arial, Helvetica, sans-serif&quot; color=&quot;#2e3440&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;#23 As a Cleaner, I want to search service listings so that I can compare my services with other services listed&lt;/span&gt;&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="44.55" y="8266" width="399" height="37" as="geometry" />
        </mxCell>
        <mxCell id="oDsTDifMXU8W_QaUGRU--17" value="&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Use Case:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;Search Service Listings&lt;/span&gt;&lt;div&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Actor: Cleaner&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Description: Cleaner can search available service listings in order to compare prices, availability, and descriptions&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Trigger: Cleaner clicks &quot;Apply&quot; to search for service listings&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Preconditions:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Cleaner must be logged in&lt;/span&gt;&lt;/div&gt;&lt;div&gt;- Cleaner must already be in &quot;My Service Listings&quot;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Normal flow:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;1. Cleaner enters keywords or selects filters e.g. service category, price range&amp;nbsp;&lt;/div&gt;&lt;div&gt;2. Cleaner submits search or filter by clicking on Apply&quot;&lt;/div&gt;&lt;div&gt;3. The system displays list of relevant service listings&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Alternate flow:&amp;nbsp;&lt;/span&gt;&lt;br style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1a. No listings match the search criteria&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- The system displays &quot;No matching listings found&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;2b. System error&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- System displays error message &quot;Failed to search service listings due to a server error.&quot;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="-8.45" y="9010.69" width="573.5" height="351.31" as="geometry" />
        </mxCell>
