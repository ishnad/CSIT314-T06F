        <mxCell id="qF_ZX2SOCg6wCa83a_pU-5" value="Use Case Diagram" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="262.09999999999997" y="1926.0000000000005" width="136" height="30" as="geometry" />
        </mxCell>
        <mxCell id="qF_ZX2SOCg6wCa83a_pU-7" value="&lt;div&gt;Use Case: Generate Daily Report&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Actor: Platform Management&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Description: Platform Management generates daily report to monitor user activities on the website&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Trigger: Platform Management clicks on &quot;Generate Daily Report&quot; button&lt;/div&gt;&lt;div&gt;&lt;br style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Preconditions:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Platform Management is logged in with Administrator rights&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Platform Management is on &quot;Platform Management&quot; dashboard&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Normal flow:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;1. Platform Management clicks on &quot;Generate Daily Report&quot; at the &quot;Generate Reports&quot; Section of the dashboard&lt;/div&gt;&lt;div&gt;2.&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;System retrieves user activities (e.g. total logins to the website, total new registrations, bookings confirmed) from the past 24 hours&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3. System compiles user activities and displays it as report&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Alternate flow:&amp;nbsp;&lt;/span&gt;&lt;br style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2a. No user activities found for the past 24 hours&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- System displays &quot;No Daily Report to be generated&quot;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2b. System error&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- System displays error message &quot;An unexpected error occurred while generating the daily report.&quot;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="71.1" y="2716" width="525" height="358" as="geometry" />
        </mxCell>
        <mxCell id="qF_ZX2SOCg6wCa83a_pU-8" value="&lt;div&gt;Use Case Description&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="267.34999999999997" y="2690.0000000000005" width="134" height="26" as="geometry" />
        </mxCell>
        <mxCell id="qF_ZX2SOCg6wCa83a_pU-9" value="#33" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="316.99999999999994" y="2637.7600000000007" width="40" height="30" as="geometry" />
        </mxCell>
        <mxCell id="qF_ZX2SOCg6wCa83a_pU-10" value="#33&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;As a Platform Management, I want to generate Daily reports to monitor user activities on the website.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="42.099999999999994" y="1843" width="576" height="41" as="geometry" />
