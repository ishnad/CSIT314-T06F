// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER MODELS
model UserAccount {
  id        String     @id @default(cuid())
  username  String     @unique
  email     String     @unique
  password  String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relation to UserProfile model
  userProfileId String? // Foreign key
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id])

  // Relation to ServiceListings created by this user (if they are a Cleaner)
  serviceListings ServiceListing[]

  // Relations for ProfileView
  profileViews      ProfileView[] @relation("ViewedProfile") // Profiles views this user received
  viewedOthers      ProfileView[] @relation("ProfileViewer") // Profiles this user viewed
}

// Define standard permissions
enum Permission {
  MANAGE_SERVICES // e.g., Cleaners creating/managing their listings
  ADMIN_PRIVILEGES // e.g., UserAdmins managing users, profiles, etc.
  SEARCH_CLEANERS // e.g., Homeowners searching for cleaners/listings
  VIEW_REPORTS // e.g., Platform Management viewing reports
}

// New UserProfile model to allow dynamic creation
model UserProfile {
  id          String       @id @default(cuid())
  name        String       @unique // e.g., "HomeOwner", "Cleaner", "UserAdmin"
  permissions Permission[] // List of permissions granted to this profile
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relation back to UserAccount
  userAccounts UserAccount[]
  // Relation to ServiceListing (if a profile can be associated with listings, e.g., category management)
  // serviceListings ServiceListing[] // Optional: Add if profiles manage listings directly

  status UserProfileStatus @default(ACTIVE) // Status of the user profile
}

enum UserProfileStatus {
  ACTIVE
  SUSPENDED
}

// Relation from UserAccount to ServiceListing
model ServiceListing {
  id            String   @id @default(cuid())
  serviceType   String   // e.g., "Deep Cleaning", "Basic Cleaning", "Window Cleaning"
  title         String
  description   String
  ratePerHr     Float    // Rate per hour
  duration      Float    // Estimated duration in hours
  availability  DateTime // Specific date/time available - might need refinement later
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relation to the Cleaner (UserAccount) who created the listing
  cleanerId String
  cleaner   UserAccount @relation(fields: [cleanerId], references: [id])

  @@index([cleanerId]) // Index for faster lookups by cleaner
}


enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

// Model to track profile views
model ProfileView {
  id              String   @id @default(cuid())
  viewedProfileId String   // ID of the UserAccount (Cleaner) whose profile was viewed
  viewedProfile   UserAccount @relation("ViewedProfile", fields: [viewedProfileId], references: [id], onDelete: Cascade) // If cleaner account is deleted, views are removed
  viewerId        String?  // ID of the UserAccount who viewed the profile (optional, if logged in)
  viewer          UserAccount? @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: SetNull) // If viewer account is deleted, viewerId becomes null
  viewedAt        DateTime @default(now())

  @@index([viewedProfileId, viewedAt])
  @@index([viewerId])
}
