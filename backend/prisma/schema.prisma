// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER MODELS
model UserAccount {
  id        String     @id @default(cuid())
  username  String     @unique
  email     String     @unique
  password  String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relation to UserProfile model
  userProfileId String? // Foreign key
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id])

  // Relation to ServiceListings created by this user (if they are a Cleaner)
  serviceListings ServiceListing[]

  // Relations for ProfileView
  profileViews ProfileView[] @relation("ViewedProfile") // Profiles views this user received
  viewedOthers ProfileView[] @relation("ProfileViewer") // Profiles this user viewed

  // Relations for Shortlist
  createdShortlists Shortlist[] @relation("HomeownerShortlists") // Shortlists created by this user (if Homeowner)
  shortlistedIn     Shortlist[] @relation("CleanerShortlistedIn") // Instances where this user (if Cleaner) was shortlisted

  // Relations for ConfirmedMatch
  confirmedMatchesAsHomeowner ConfirmedMatch[] @relation("HomeownerMatches") // Matches this user (as Homeowner) has confirmed
  // Cleaners are linked to ConfirmedMatch via their ServiceListings

  // Relations for ServiceBooking
  serviceBookings ServiceBooking[] @relation("HomeownerBookings") // Past service bookings
  ServiceBooking  ServiceBooking[]
}

// Define standard permissions
enum Permission {
  MANAGE_SERVICES // e.g., Cleaners creating/managing their listings
  ADMIN_PRIVILEGES // e.g., UserAdmins managing users, profiles, etc.
  SEARCH_CLEANERS // e.g., Homeowners searching for cleaners/listings
  VIEW_REPORTS // e.g., Platform Management viewing reports
}

// New UserProfile model to allow dynamic creation
model UserProfile {
  id          String       @id @default(cuid())
  name        String       @unique // e.g., "HomeOwner", "Cleaner", "UserAdmin"
  permissions Permission[] // List of permissions granted to this profile
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relation back to UserAccount
  userAccounts UserAccount[]
  // Relation to ServiceListing (if a profile can be associated with listings, e.g., category management)
  // serviceListings ServiceListing[] // Optional: Add if profiles manage listings directly

  status UserProfileStatus @default(ACTIVE) // Status of the user profile
}

enum UserProfileStatus {
  ACTIVE
  SUSPENDED
}

// Relation from UserAccount to ServiceListing
model ServiceListing {
  id          String   @id @default(cuid())
  serviceType String // e.g., "Deep Cleaning", "Basic Cleaning", "Window Cleaning"
  title       String
  description String
  ratePerHr   Float // Rate per hour
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to the Cleaner (UserAccount) who created the listing
  cleanerId String
  cleaner   UserAccount @relation(fields: [cleanerId], references: [id])

  // Relation to ConfirmedMatches
  confirmedMatches ConfirmedMatch[]

  status ServiceListingStatus @default(ACTIVE) // Status of the listing

  @@index([cleanerId]) // Index for faster lookups by cleaner
  @@index([cleanerId, status]) // For cleaners to view their listings by status
}

enum ServiceListingStatus {
  ACTIVE
  SUSPENDED
  // ARCHIVED // Future potential status
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

// Model to track profile views
model ProfileView {
  id              String       @id @default(cuid())
  viewedProfileId String // ID of the UserAccount (Cleaner) whose profile was viewed
  viewedProfile   UserAccount  @relation("ViewedProfile", fields: [viewedProfileId], references: [id], onDelete: Cascade) // If cleaner account is deleted, views are removed
  viewerId        String? // ID of the UserAccount who viewed the profile (optional, if logged in)
  viewer          UserAccount? @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: SetNull) // If viewer account is deleted, viewerId becomes null
  viewedAt        DateTime     @default(now())

  @@index([viewedProfileId, viewedAt])
  @@index([viewerId])
}

// Model to track when a Homeowner shortlists a Cleaner
model Shortlist {
  id          String      @id @default(cuid())
  homeownerId String // ID of the UserAccount (Homeowner) who created the shortlist
  homeowner   UserAccount @relation("HomeownerShortlists", fields: [homeownerId], references: [id], onDelete: Cascade)
  cleanerId   String // ID of the UserAccount (Cleaner) who was shortlisted
  cleaner     UserAccount @relation("CleanerShortlistedIn", fields: [cleanerId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([homeownerId, cleanerId]) // A homeowner can shortlist a cleaner only once
  @@index([homeownerId])
  @@index([cleanerId])
}

// Model to track confirmed matches between a Homeowner and a Cleaner's ServiceListing
model ConfirmedMatch {
  id               String         @id @default(cuid())
  serviceListingId String
  serviceListing   ServiceListing @relation(fields: [serviceListingId], references: [id], onDelete: Cascade) // If listing deleted, match is removed
  homeownerId      String
  homeowner        UserAccount    @relation("HomeownerMatches", fields: [homeownerId], references: [id], onDelete: Cascade) // If homeowner deleted, match is removed
  confirmationDate DateTime       @default(now()) // Date the match was confirmed
  // status        MatchStatus @default(CONFIRMED) // Optional: For future expansion (e.g., COMPLETED, CANCELLED_BY_HOMEOWNER, CANCELLED_BY_CLEANER)

  @@index([serviceListingId])
  @@index([homeownerId])
  @@index([confirmationDate])
  @@index([serviceListingId, confirmationDate]) // For cleaner's view, filtering by date
}

// Service Booking model for tracking completed services
model ServiceBooking {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  cleanerId   String
  cleaner     UserAccount   @relation(fields: [cleanerId], references: [id])
  homeownerId String
  homeowner   UserAccount   @relation("HomeownerBookings", fields: [homeownerId], references: [id])
  serviceDate DateTime
  status      BookingStatus
  serviceType String
  ratePerHr   Float
  hours       Float
  totalAmount Float
  createdAt   DateTime      @default(now())

  @@index([homeownerId])
  @@index([cleanerId])
  @@index([serviceDate])
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}
