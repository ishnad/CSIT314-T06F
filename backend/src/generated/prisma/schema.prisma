// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER MODELS
model UserAccount {
  id        String     @id @default(cuid())
  username  String     @unique
  email     String     @unique
  password  String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) // Used for registration tracking
  updatedAt DateTime   @updatedAt

  userProfileId String?
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id])

  serviceListings             ServiceListing[]
  profileViews                ProfileView[]    @relation("ViewedProfile")
  viewedOthers                ProfileView[]    @relation("ProfileViewer")
  createdShortlists           Shortlist[]      @relation("HomeownerShortlists")
  shortlistedIn               Shortlist[]      @relation("CleanerShortlistedIn")
  confirmedMatchesAsHomeowner ConfirmedMatch[] @relation("HomeownerMatches")
  serviceBookingsAsHomeowner  ServiceBooking[] @relation("HomeownerBookings") // Renamed for clarity
  serviceBookingsAsCleaner    ServiceBooking[] @relation("CleanerBookings") // Renamed for clarity

  // Relation to UserLoginLog
  loginLogs UserLoginLog[] // A user can have many login logs
}

model UserLoginLog {
  id        String      @id @default(cuid())
  userId    String
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginTime DateTime    @default(now())
  ipAddress String? // Optional: store IP address
  userAgent String? // Optional: store user agent

  @@index([userId])
  @@index([loginTime])
}

enum Permission {
  MANAGE_SERVICES
  ADMIN_PRIVILEGES
  SEARCH_CLEANERS
  VIEW_REPORTS
  MANAGE_CATEGORIES
}

model UserProfile {
  id           String            @id @default(cuid())
  name         String            @unique
  permissions  Permission[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  userAccounts UserAccount[]
  status       UserProfileStatus @default(ACTIVE)
}

enum UserProfileStatus {
  ACTIVE
  SUSPENDED
}

enum ServiceCategoryStatus {
  ACTIVE
  INACTIVE
}

model ServiceCategory {
  id                    String                @id @default(cuid())
  serviceCatName        String                @unique // e.g., "Window Cleaning", "Deep Cleaning"
  serviceCatDescription String? // Optional description for the category
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  status                ServiceCategoryStatus @default(ACTIVE) // Default to ACTIVE when created

  serviceListings ServiceListing[]

  @@index([status]) // Add index for status for faster filtering
  @@index([serviceCatName]) // Index for searching by name
}

model ServiceListing {
  id                String               @id @default(cuid())
  description       String
  ratePerHr         Float
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  cleanerId         String
  cleaner           UserAccount          @relation(fields: [cleanerId], references: [id])
  serviceCategoryId String?
  serviceCategory   ServiceCategory?     @relation(fields: [serviceCategoryId], references: [id])
  confirmedMatches  ConfirmedMatch[]
  status            ServiceListingStatus @default(ACTIVE)

  @@index([cleanerId])
  @@index([cleanerId, status])
  @@index([serviceCategoryId])
}

enum ServiceListingStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

model ProfileView {
  id              String       @id @default(cuid())
  viewedProfileId String
  viewedProfile   UserAccount  @relation("ViewedProfile", fields: [viewedProfileId], references: [id], onDelete: Cascade)
  viewerId        String?
  viewer          UserAccount? @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: SetNull)
  viewedAt        DateTime     @default(now())

  @@index([viewedProfileId, viewedAt])
  @@index([viewerId])
}

model Shortlist {
  id          String      @id @default(cuid())
  homeownerId String
  homeowner   UserAccount @relation("HomeownerShortlists", fields: [homeownerId], references: [id], onDelete: Cascade)
  cleanerId   String
  cleaner     UserAccount @relation("CleanerShortlistedIn", fields: [cleanerId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([homeownerId, cleanerId])
  @@index([homeownerId])
  @@index([cleanerId])
}

model ConfirmedMatch {
  id               String         @id @default(cuid())
  serviceListingId String
  serviceListing   ServiceListing @relation(fields: [serviceListingId], references: [id], onDelete: Cascade)
  homeownerId      String
  homeowner        UserAccount    @relation("HomeownerMatches", fields: [homeownerId], references: [id], onDelete: Cascade)
  confirmationDate DateTime       @default(now())

  @@index([serviceListingId])
  @@index([homeownerId])
  @@index([confirmationDate])
  @@index([serviceListingId, confirmationDate])
}

model ServiceBooking {
  id          String        @id @default(cuid())
  bookingId   String        @unique // Assuming this is a business identifier
  cleanerId   String
  cleaner     UserAccount   @relation("CleanerBookings", fields: [cleanerId], references: [id]) // Specify relation name
  homeownerId String
  homeowner   UserAccount   @relation("HomeownerBookings", fields: [homeownerId], references: [id]) // Specify relation name
  serviceDate DateTime
  status      BookingStatus // Used for confirmed bookings tracking
  serviceType String
  ratePerHr   Float
  hours       Float
  totalAmount Float
  createdAt   DateTime      @default(now()) // Can be used to track when booking was confirmed if status is set on creation

  @@index([homeownerId])
  @@index([cleanerId])
  @@index([serviceDate])
  @@index([status, createdAt]) // Index for querying confirmed bookings in a period
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}
